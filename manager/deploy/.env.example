# ===== Cub3D 更新管理器 · 生产环境变量模板 =====
# 复制为 /etc/cub3d-manager.env 并修改后部署：
#   sudo cp .env.example /etc/cub3d-manager.env && sudo chmod 600 /etc/cub3d-manager.env
#   sudo nano /etc/cub3d-manager.env

# ---------- 必改：管理后台登录密码（即后台令牌）----------
# 请用强随机串：  openssl rand -hex 24
# 注意：这同时是更新话术系统与打包分发系统共用的登录密码（二者共享登录态）
ADMIN_TOKEN=请改成强随机串

# ---------- 下载/分发目录（境内安装包落盘处）----------
# 更新话术系统与打包分发系统共用此目录，确保二者数据打通
CUB3D_DOWNLOADS=/var/www/cub3d/downloads

# ---------- 监听端口（nginx 反代到 127.0.0.1:此端口）----------
PORT=3000

# ---------- 子路径前缀（一般留空）----------
# nginx 已用 rewrite 去前缀转发 /manager → 实例根，故 BASE 保持空即可
BASE=

# ---------- 登录账号（一般不动）----------
ADMIN_USER=yushichadao

# ---------- 跨域（客户端拉取公开接口；默认 * 即可）----------
CORS_ALLOW=*

# ---------- 百度翻译（更新话术多语言自动翻译用；可留内置默认）----------
BAIDU_APPID=20260822002670936
BAIDU_KEY=p8LWRjAJOzEDrA9NIddh

# ---------- 打包分发系统 · 境外分发（GitHub Releases）----------
# 不配置则「境外 GitHub」卡片灰度禁用，仅境内分发可用
GH_REPO=yushichadao/Cub3D-Editor
GH_TOKEN=
# 本地打包输出目录（留空 = 仓库内 release/<版本>/）；建议显式指定大磁盘路径
# CUB3D_RELEASE_OUT=/var/www/cub3d/release
