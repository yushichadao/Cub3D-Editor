{
  "appId": "com.lifang.editor3d",
  "appName": "立方3D",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#0b0f14",
    "useLegacyBridge": false,
    "plugins": [
      { "androidClass": "com.lifang.editor3d.FileSaverPlugin" }
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0b0f14",
      "androidSpinnerStyle": "small",
      "spinnerColor": "#38bdf8",
      "showSpinner": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0f14",
      "overlaysWebView": false
    }
  }
}
