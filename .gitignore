# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.log
.codebuddy/

# ===== Node 依赖（体积大，由各端 install 生成）=====
node_modules/
**/node_modules/

# ===== 各端构建产物 / 打包输出 =====
# 所有 dist 目录（含仓库根 dist/）一律忽略：正式安装包改为 GitHub Releases 附件，
# 不再随源码入库，避免历史体积膨胀（每个 ~95MB 的 exe 反复入库会撑大 .git）。
**/dist/
dist/*
dist-build/
**/dist-build/
www/
**/www/
build/
**/build/
# 例外：PC 构建资源源文件（图标 icon.ico/icon.png、NSIS 脚本 installer.nsh、侧边栏图 installer-sidebar.bmp）必须入库
!PC/build/
android/.gradle/
android/.idea/
android/app/release/
android/app/debug/
android/local.properties
android/capacitor-cordova-android-plugins/

# ===== 签名密钥（绝不入库）=====
*.keystore
*.jks
keystore.properties

# ===== 同步生成的产物（由 sync-shared.mjs 在构建时再生）=====
# 注意：shared/ 下的源文件（docs/infra/scripts/three/language）是单一源，需入库；
#       各端从 shared 同步出来的副本由 predev/prestart/prepack/predist 钩子生成，无需入库。
# 此处仅排除同步脚本本身的临时产物（如有）。

# ===== Vercel / 平台缓存 =====
.vercel/

# ===== 测试产物 / 个人工具配置 =====
.playwright-cli/
.trae/
.idea/

# ===== 各端平台专属 IDE 配置（可选保留，这里排除以避免噪音）=====
.vscode/

# ===== 运行时用户数据（自动保存、配置缓存等，绝不入库）=====
.userdata/
**/.userdata/

# ===== 临时构建目录 / 诊断脚本（排查用，不入库）=====
dist_build/
**/dist_build/
cap_diag*.bat
check_exe*.ps1
_check*.ps1

# ===== 一次性排查 / 调试产物（根目录，均非打包依赖，运行时再生）=====
_audit_tmp.mjs
_out*.txt
_out*.json
_out_shapeparams.json
_out_toc.txt
_z1.txt
cap_diag*.log
cap_update_diag*.log
missing_terms.txt

# ===== 正式版安装包统一放在仓库根 dist/ 目录（通用名，随仓库分发）=====
# 各端原始构建目录（Web/dist、PC/dist、Android/dist 等）仍按上方规则忽略，避免仓库体积膨胀；
# 仅 dist/ 下的成品（Cub3D-Editor-Setup.exe / Cub3D-Editor-Portable.exe / Cub3D-Editor.apk）入库。

# ===== 临时 wiki 工作目录（生成/排查用，不入库）=====
wiki-tmp/

