experiments/
_audit_tmp.mjs
_out*.txt
_out*.json
_out_shapeparams.json
_out_toc.txt
_z1.txt
cap_diag*.log
cap_update_diag*.log
missing_terms.txt

# ===== 诊断 / 截图 / 探针 / 回归 临时脚本与图片（排查用，不入库）=====
_diag_*.cjs
_diag_*.mjs
_diag_*.png
