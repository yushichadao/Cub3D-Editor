# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.log
.codebuddy/

# ===== Node 依赖（体积大，由各端 install 生成）=====
node_modules/
**/node_modules/

# ===== 各端构建产物 / 打包输出 =====
# 所有 dist 目录（含仓库根 dist/）一律忽略：正式安装包通过 GitHub Releases 分发，
# 不再随源码入库，避免历史体积膨胀（每个 ~100MB 的 exe 反复入库会撑大 .git）。
**/dist/
dist/*
dist-build/
**/dist-build/
www/
**/www/
build/
**/build/
# 例外：PC 构建资源源文件（图标 icon.ico/icon.png、NSIS 脚本 installer.nsh、侧边栏图 installer-sidebar.bmp）必须入库
!PC/build/
android/.gradle/
android/.idea/
android/app/release/
android/app/debug/
android/local.properties
android/capacitor-cordova-android-plugins/

# ===== 签名密钥（绝不入库）=====
*.keystore
*.jks
keystore.properties

# ===== 同步生成的产物（由 sync-shared.mjs 在构建时再生）=====
# 注意：shared/ 下的源文件（docs/infra/scripts/three/language）是单一源，需入库；
#       各端从 shared 同步出来的副本由 predev/prestart/prepack/predist 钩子生成，无需入库。
# 此处仅排除同步脚本本身的临时产物（如有）。

# ===== Vercel / 平台缓存 =====
.vercel/

# ===== 测试产物 / 个人工具配置 =====
.playwright-cli/
.trae/
.idea/

# ===== 各端平台专属 IDE 配置（可选保留，这里排除以避免噪音）=====
.vscode/

# ===== 运行时用户数据（自动保存、配置缓存等，绝不入库）=====
.userdata/
**/.userdata/

# ===== 临时构建目录 / 诊断脚本（排查用，不入库）=====
dist_build/
**/dist_build/
cap_diag*.bat
check_exe*.ps1
_check*.ps1

# ===== 一次性排查 / 调试产物（根目录，均非打包依赖，运行时再生）=====
# 本地实验/试做目录（如 boot-demo.html），不入库
experiments/
_audit_tmp.mjs
_out*.txt
_out*.json
_out_shapeparams.json
_out_toc.txt
_z1.txt
cap_diag*.log
cap_update_diag*.log
missing_terms.txt

# ===== 诊断 / 截图 / 探针 / 回归 临时脚本与图片（排查用，不入库）=====
_diag_*.cjs
_diag_*.mjs
_diag_*.png
_probe*.mjs
_probe*.ps1
_render_test.cjs
_shot_*.cjs
_shot_*.png
_test_*.cjs
_tos_*.cjs
_tos_*.png
_tos_gate_demo.html
# 语言/手册草稿与步骤 yaml（排查与生成中间产物，不入库）
i18n-draft/
*.yaml


# ===== 临时 wiki 工作目录（生成/排查用，不入库）=====
wiki-tmp/

# ===== 发布安装包产物（由 release.mjs 生成，经 GitHub Releases 分发，不入库）=====
Release/
**/Release/

# 境内站点 downloads/ 镜像安装包（大文件，走站内/Releases，不入库）；
# 仅 versions.json（版本与体积元数据）入库。
downloads/*.exe
downloads/*.apk

# ===== 图标替换/产物整理产生的旧文件备份与检查图（安全网，不入库）=====
*.bak
icon-backups/
**/icon-backups/

