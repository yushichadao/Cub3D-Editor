# ===== 治理新增：密钥集中（真实值不入库，模板入库）=====
secrets/.env
secrets/**/.env
!secrets/.env.example
# Android 签名密钥库（真实不入库，路径指向仓库内 toolchain/ 或 android/android/）
toolchain/android/release.keystore
toolchain/android/keystore.properties
android/android/release.keystore
android/android/keystore.properties
# Android 工具链（JDK/SDK 收敛仓库内，体积大不入库）
toolchain/jdk*/
toolchain/android-sdk/
toolchain/**/*.zip
# 实际工具链位置（JDK/SDK 在工程内 dev-tools/，体积大不入库）
dev-tools/

# ===== 治理新增：实验隔离区（论证 demo + 截图，不进产品面）=====
lab/_tmp/
lab/assets/
!lab/.gitkeep
!lab/assets/.gitkeep

# ===== 治理新增：PC 端运行时用户数据（收敛仓库内，不入库）=====
pc/.runtime/
.runtime/

# ===== 治理新增：构建产物（electron-builder 输出）=====
pc/out/
pc/dist/
**/out/
**/dist/

# ===== 安装包产物不入库（经 GitHub Releases 分发）=====
downloads/
# 单数 download/ 下的安装包（exe/apk/blockmap）不入库（走 Releases 分发，且 GitHub 单文件硬限 100MB）；
# 附属物清单 SHA256SUMS.txt / versions.json 体积小，照常入库。
download/*.exe
download/*.apk
download/*.blockmap

# ===== 本地自签名证书（绝不可入库，公开仓库；Windows 大小写不敏感使 !PC/build/ 例外误放行 pc/build/）=====
pc/build/*.pfx
pc/build/*.cer
pc/build/codesign.*
# 本地诊断/验证临时脚本（排查用，不入库）
_diag*.ps1
_diag*.ps1.bak

