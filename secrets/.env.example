# Cub3D Editor 集中密钥模板（入库）
# 复制本文件为 secrets/.env 并填入真实值；secrets/.env 已被 .gitignore 忽略，绝不入库。
# 所有端脚本统一从此文件读取，杜绝散落（原硬编码于 manager/server.mjs、tools/publish-updates.mjs 的百度凭证必须迁移至此）。

# ===== 管理端 =====
# 管理页鉴权令牌（原 manager/server.mjs 硬编码 DEFAULT_ADMIN_TOKEN，已迁移）
ADMIN_TOKEN=change-me-to-strong-token

# ===== 云端部署 / 更新源 =====
# 云端 downloads 权威副本根（服务器绝对路径，从零重建）
CUB3D_DOWNLOADS=/www/wwwroot/139.196.104.56/downloads
# 部署目标服务器（rsync/ssh）。备案后可切 cub3d-editor.cn
DEPLOY_HOST=139.196.104.56
DEPLOY_USER=root
DEPLOY_ROOT=/www/wwwroot/139.196.104.56
# 管理端服务端口
PORT=3000
# nginx 透传子路径前缀（空=站点根直连）
MANAGER_BASE=/manager
# CORS 允许源（多值逗号分隔）
CORS_ALLOW=https://cub3d-editor.cn,http://139.196.104.56

# ===== GitHub（用于 GitHub Releases 代理拉取）=====
GH_TOKEN=change-me-github-pat

# ===== 百度翻译（仅管理端“更新说明”多语言化，不进客户端运行时）=====
BAIDU_TRANSLATE_APP_ID=change-me-app-id
BAIDU_TRANSLATE_KEY=change-me-app-key

# ===== Android 签名（路径指向仓库内 toolchain/，真实 keystore 不入库）=====
ANDROID_KEYSTORE_PATH=toolchain/android/release.keystore
ANDROID_KEY_ALIAS=cub3d
ANDROID_KEY_PASSWORD=change-me-key-pass
ANDROID_STORE_PASSWORD=change-me-store-pass
