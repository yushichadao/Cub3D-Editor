{
  "name": "cub3d-editor",
  "productName": "立方·3D设计工坊",
  "version": "1.0.0",
  "private": true,
  "description": "立方·3D设计工坊 — 离线桌面版 3D/2D 场景编辑器，支持多语言界面与多编程语言插件扩展",
  "author": {
    "name": "Yushichadao",
    "email": "yushichadao@users.noreply.github.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node ../sync-shared.mjs",
    "prestart": "node ../sync-shared.mjs",
    "prepack": "node scripts/_deref-junctions.mjs && node ../sync-shared.mjs",
    "predist": "node scripts/_deref-junctions.mjs && node ../sync-shared.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node server.js",
    "icon": "node scripts/_genicon.mjs",
    "pack": "electron-builder --dir",
    "dist": "npm run icon && electron-builder",
    "dist:setup": "npm run icon && electron-builder --win nsis",
    "dist:portable": "npm run icon && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
